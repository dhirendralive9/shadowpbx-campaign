# ---- Asterisk ARI (local) ----
ARI_URL=http://127.0.0.1:8088
ARI_USER=campaign
ARI_PASS=CHANGE_ME_long_random
ARI_APP=shadowpbx-campaign

# ---- German VoIP trunk (same creds as your working ShadowPBX trunk) ----
TRUNK_HOST=sip.yourprovider.de
TRUNK_USER=your_sip_user
TRUNK_PASS=your_sip_password
TRUNK_ENDPOINT=PJSIP/german-trunk
CALLER_ID=491511193838

# ---- Main ShadowPBX (press-1 transfer target) ----
PBX_HOST=89.117.51.116
PBX_PORT=5060
PBX_ENDPOINT=PJSIP/shadowpbx
AGENT_EXTEN=2000

# ---- IVR behaviour ----
GREETING=sound:/var/lib/asterisk/sounds/campaign/greeting
CONFIRM_KEY=1
OPTOUT_KEY=2
MAX_GREETINGS=2
WAIT_SECONDS=8

# ---- Main PBX API (phase 2: agent reserve/availability) ----
PBX_API_URL=https://shadowpbxeu.ddns.net/api/campaign
PBX_API_KEY=CHANGE_ME_32_byte_random

# ---- Hardening (all optional) ----
# Signs session cookies. If unset, a random key is generated once and kept in
# data/.session-secret (mode 600). Must be 32+ characters if you set it.
# SESSION_SECRET=
#
# Listen address. 127.0.0.1 keeps the UI off the public interface; use it when
# the UI sits behind a TLS proxy (Caddy/Traefik/nginx) or is reached by VPN/SSH.
# HOST=0.0.0.0
#
# Set both once the UI is served over HTTPS through a proxy: TRUST_PROXY makes
# client IPs (used by the login limiter) and secure cookies work behind it.
# TRUST_PROXY=1
# COOKIE_SECURE=1
