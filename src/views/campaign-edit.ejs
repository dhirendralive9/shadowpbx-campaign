<%- include('head', { title: campaign ? campaign.name : 'New campaign', active: 'campaigns' }) %>
<%- include('flash') %>
<% var c = campaign || { id:'', name:'', trunkId:'', serverId:'', leadListId:'',
                         ivr: defaults.ivr, pacing: defaults.pacing };
   function sel(a,b){ return a===b ? 'selected' : ''; }
   function audioOpts(current){
     var h = '<option value="">— none —</option>';
     files.forEach(function(f){
       h += '<option value="'+f.soundId+'" '+(current===f.soundId?'selected':'')+'>'+
            f.name+' ('+f.seconds+'s)</option>'; });
     return h;
   } %>
<form method="post" action="/campaigns/save">
<input type="hidden" name="id" value="<%= c.id %>">

<div class="section">
  <div class="sec-head"><div class="sec-title"><%= campaign ? 'Edit campaign' : 'New campaign' %></div>
    <a class="sec-link" href="/campaigns">← All campaigns</a></div>
  <div class="card">
    <div class="grid-2">
      <div class="form-group"><label class="form-label">Campaign name</label>
        <input class="form-input" name="name" value="<%= c.name %>" placeholder="German Sales" required></div>
      <div class="form-group"><label class="form-label">Lead list</label>
        <select class="form-select" name="leadListId" required>
          <option value="">Select…</option>
          <% lists.forEach(function(l){ %>
            <option value="<%= l.id %>" <%= sel(l.id, c.leadListId) %>><%= l.name %> — <%= l.total %> leads (+<%= l.dialCode %>)</option>
          <% }) %>
        </select>
        <% if (!lists.length) { %><span class="muted" style="font-size:10px">No lists yet — <a href="/leads">create one</a>.</span><% } %>
      </div>
      <div class="form-group"><label class="form-label">Trunk <span class="muted">(who we dial through)</span></label>
        <select class="form-select" name="trunkId" required>
          <option value="">Select…</option>
          <% (settings.trunks||[]).forEach(function(t){ %>
            <option value="<%= t.id %>" <%= sel(t.id, c.trunkId) %>><%= t.name %> — <%= t.host %></option>
          <% }) %>
        </select></div>
      <div class="form-group"><label class="form-label">Server <span class="muted">(where confirmed leads go)</span></label>
        <select class="form-select" name="serverId" required>
          <option value="">Select…</option>
          <% (settings.servers||[]).forEach(function(s){ %>
            <option value="<%= s.id %>" <%= sel(s.id, c.serverId) %>><%= s.name %><%= s.routeNumber ? ' — route ' + s.routeNumber : '' %></option>
          <% }) %>
        </select></div>
    </div>
  </div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title">IVR flow</div>
    <span class="muted" style="font-size:11px">Built once on the IVR tab, reused by any campaign</span></div>
  <div class="card">
    <% if (!flows.length) { %>
      <div class="alert alert-warn">No IVR flows yet — build one on the
        <a href="/ivr">IVR</a> tab. A campaign cannot run without one.</div>
    <% } else { %>
    <div class="grid-2">
      <div class="form-group"><label class="form-label">Flow
          <span class="pill p-miss" style="font-size:9px">required</span></label>
        <select class="form-select" name="ivrFlowId" required>
          <option value="">Select…</option>
          <% flows.forEach(function(f){ %>
            <option value="<%= f.id %>" <%= sel(f.id, c.ivrFlowId) %>><%= f.name %></option>
          <% }) %>
        </select>
        <span class="muted" style="font-size:10px">Greeting, every key and its action, the retry
          limits and the goodbye all live in the flow.</span></div>
      <div class="form-group"><label class="form-label">Agent ring timeout (s)</label>
        <input class="form-input" name="agentRingSeconds" type="number" min="10" max="120"
               value="<%= c.ivr.agentRingSeconds %>">
        <span class="muted" style="font-size:10px">How long the agent's phone rings before the lead
          is handed back to the flow.</span></div>
    </div>

    <!-- Hidden field first: an unticked checkbox submits nothing, so without
         it this could be switched on and never off again. -->
    <div class="grid-3">
      <div class="form-group"><label class="form-label">Max seconds per call</label>
        <input class="form-input" name="maxCallSeconds" type="number" min="0" max="600"
               value="<%= c.ivr.maxCallSeconds %>">
        <span class="muted" style="font-size:10px">Ceiling on the menu part of a call, timed from
          the dial. The round limits cap how many prompts play, not how long the call lasts — and a
          line held for two minutes by someone who pressed nothing is what exhausts a trunk's
          channels. Never applies once a call reaches an agent. 0 = no limit.</span></div>
    </div>

    <input type="hidden" name="detectMachines" value="false">
    <label class="form-label" style="display:flex;align-items:center;gap:8px;margin:14px 0 6px">
      <input type="checkbox" name="detectMachines" value="true"
             <%= c.ivr.detectMachines ? 'checked' : '' %>>
      Hang up on answering machines</label>
    <div class="muted" style="font-size:11px;margin-bottom:12px">
      Listens for about four seconds after the call is answered and drops it if it sounds like
      voicemail, instead of playing the prompt to a machine and waiting out the full menu.
      <strong>This is a guess, not a fact.</strong> It costs every real person a short silence
      before the prompt starts, and it will occasionally drop a live lead — check the
      <em>Answering machine</em> count in the report against your connect rate before trusting it.
      Worth switching on mainly when your trunk has a channel limit, since a machine otherwise
      holds a line for the whole menu.</div>
    <% flows.forEach(function(f){ %>
      <div class="muted" data-flow="<%= f.id %>" style="font-size:11px;margin-top:8px;display:none">
        <strong><%= f.name %></strong> —
        <% f.keys.forEach(function(k){ %>
          press <span class="mono"><%= k.key %></span>:
          <%= actions[k.action] ? actions[k.action].label.toLowerCase() : k.action %><%= k.label ? ' (' + k.label + ')' : '' %>;
        <% }) %>
        <%= f.timeoutSeconds %>s to answer, <%= f.maxInvalid %> wrong presses,
        <%= f.maxNoInput %> silent rounds, then it hangs up.
        <a href="/ivr?edit=<%= f.id %>">Edit</a>
      </div>
    <% }) %>
    <script>
    (function(){
      var sel = document.querySelector('[name="ivrFlowId"]');
      function show(){
        document.querySelectorAll('[data-flow]').forEach(function(el){
          el.style.display = el.getAttribute('data-flow') === sel.value ? 'block' : 'none';
        });
      }
      sel.addEventListener('change', show); show();
    })();
    </script>
    <% } %>
  </div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title">Pacing</div></div>
  <div class="card">
    <div class="grid-3">
      <div class="form-group"><label class="form-label">Strategy</label>
        <select class="form-select" name="strategy" id="c-strategy" onchange="syncStrategy()">
          <option value="power" <%= sel('power', c.pacing.strategy || 'power') %>>Power — one call per free agent</option>
          <option value="predictive" <%= sel('predictive', c.pacing.strategy) %>>Predictive — overdial</option>
        </select>
        <span class="muted" style="font-size:10px">Power never abandons a caller. Predictive dials
          more people than there are agents, betting most will not answer — faster, and some
          confirmed leads will find nobody free.</span></div>
      <div class="form-group"><label class="form-label">Lines per agent</label>
        <input class="form-input" name="linesPerAgent" type="number" min="1" max="50" value="<%= c.pacing.linesPerAgent %>">
        <span class="muted" style="font-size:10px">1 = one call per free agent. Above 1 is predictive overdial — faster, but some confirmed callers find no agent free.</span></div>
      <div class="form-group"><label class="form-label">Max concurrent calls</label>
        <input class="form-input" name="maxConcurrent" type="number" min="1" max="200" value="<%= c.pacing.maxConcurrent %>">
        <span class="muted" style="font-size:10px">Hard ceiling, whatever the ratio works out to.</span></div>
      <div class="form-group"><label class="form-label">Carrier CPS limit</label>
        <input class="form-input" name="callsPerSecond" type="number" min="0" max="100"
               value="<%= c.pacing.callsPerSecond %>">
        <span class="muted" style="font-size:10px">New calls per second, as the
          <strong>carrier</strong> allows — ask them, don't guess. Going over it gets the surplus
          rejected with <span class="mono">503</span> / hangup cause 34, which reads like
          congestion or a dead trunk. 0 = uncapped.</span></div>

      <div class="form-group"><label class="form-label">Calls/hour cap</label>
        <input class="form-input" name="callsPerHourCap" type="number" min="0" value="<%= c.pacing.callsPerHourCap %>">
        <span class="muted" style="font-size:10px">0 = uncapped.</span></div>
      <div class="form-group"><label class="form-label">Retry attempts</label>
        <input class="form-input" name="retryAttempts" type="number" min="0" max="5" value="<%= c.pacing.retryAttempts %>"></div>
      <div class="form-group"><label class="form-label">Retry delay (min)</label>
        <input class="form-input" name="retryDelayMinutes" type="number" min="5" max="1440" value="<%= c.pacing.retryDelayMinutes %>"></div>
    </div>
    <script>
    // Power dialling is one line per agent by definition; an editable field
    // that disagrees with the strategy is how a "safe" campaign overdials.
    function syncStrategy(){
      var pred = document.getElementById('c-strategy').value === 'predictive';
      var lpa = document.querySelector('[name="linesPerAgent"]');
      lpa.disabled = !pred;
      if (!pred) lpa.value = 1;
      lpa.closest('.form-group').style.opacity = pred ? '1' : '0.45';
    }
    syncStrategy();
    document.querySelector('form').addEventListener('submit', function(){
      document.querySelector('[name="linesPerAgent"]').disabled = false;
    });
    </script>
  </div>
</div>

<div class="section"><div class="card">
  <button class="btn btn-primary" type="submit">Save campaign</button>
  <a class="btn" href="/campaigns">Cancel</a>
</div></div>
</form>
<%- include('foot') %>
