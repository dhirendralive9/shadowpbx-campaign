<%- include('head', { title: 'Campaigns', active: 'campaigns' }) %>
<%- include('flash') %>
<div class="section">
  <div class="sec-head"><div class="sec-title">Campaigns</div>
    <a class="btn btn-sm btn-primary" href="/campaigns/new">+ New campaign</a></div>
  <div class="card">
    <% if (!campaigns.length) { %>
      <div class="empty">No campaigns yet. A campaign ties together a trunk, a server, a lead list and an IVR flow.</div>
    <% } else { %>
    <table class="tbl"><thead><tr>
      <th>Name</th><th>Trunk</th><th>Leads</th><th>Pacing</th><th>Status</th><th>Live</th><th></th>
    </tr></thead><tbody>
    <% campaigns.forEach(function(c){
         var t=(settings.trunks||[]).find(function(x){return x.id===c.trunkId;});
         var sv=(settings.servers||[]).find(function(x){return x.id===c.serverId;});
         var ll=lists.find(function(x){return x.id===c.leadListId;});
         var running = c.status==='running'; %>
      <tr>
        <td><strong><%= c.name %></strong>
          <div class="muted" style="font-size:11px"><%= sv ? sv.name : 'server missing' %></div></td>
        <td><%- t ? t.name : '<span class="pill p-err">missing</span>' %></td>
        <td><%- ll ? ll.name + ' (' + ll.total + ')' : '<span class="pill p-err">missing</span>' %></td>
        <td class="muted" style="font-size:11px">
          <%= (c.pacing.strategy || 'power') === 'predictive'
                ? 'predictive ' + c.pacing.linesPerAgent + '×/agent' : 'power' %>,
          max <%= c.pacing.maxConcurrent %><%= c.pacing.callsPerHourCap ? ', ' + c.pacing.callsPerHourCap + '/h' : '' %></td>
        <td><span class="pill <%= running?'p-ok':(c.status==='paused'?'p-warn':'p-gray') %>"
                 id="st-<%= c.id %>"><%= c.status %></span></td>
        <td class="mono" style="font-size:11px" id="live-<%= c.id %>">—</td>
        <td style="text-align:right;white-space:nowrap">
          <% if (!running) { %>
            <form class="inline-form" method="post" action="/campaigns/<%= c.id %>/start">
              <button class="btn btn-sm btn-primary" type="submit">Start</button></form>
          <% } else { %>
            <form class="inline-form" method="post" action="/campaigns/<%= c.id %>/pause">
              <button class="btn btn-sm" type="submit">Pause</button></form>
          <% } %>
          <form class="inline-form" method="post" action="/campaigns/<%= c.id %>/stop"
                onsubmit="return confirm('Stop <%= c.name %>? Calls in progress are dropped.')">
            <button class="btn btn-sm" type="submit">Stop</button></form>
          <a class="btn btn-sm" href="/campaigns/<%= c.id %>">Edit</a>
          <a class="btn btn-sm" href="/campaigns/<%= c.id %>/report">Report</a>
          <form class="inline-form" method="post" action="/campaigns/<%= c.id %>/reset-stats"
                onsubmit="return confirm('Reset the counters for <%= c.name %>?')">
            <button class="btn btn-sm" type="submit">Reset stats</button></form>
          <form class="inline-form" method="post" action="/campaigns/<%= c.id %>/delete"
                onsubmit="return confirm('Delete campaign <%= c.name %>?')">
            <button class="btn btn-sm btn-danger" type="submit">Delete</button></form>
        </td>
      </tr>
    <% }) %>
    </tbody></table>
    <% } %>
  </div>
</div>

<% campaigns.forEach(function(c){ %>
<div class="section" data-dash="<%= c.id %>">
  <div class="sec-head"><div class="sec-title"><%= c.name %> — live</div>
    <span class="muted" style="font-size:11px" id="note-<%= c.id %>"></span></div>

  <div class="kpi-row">
    <div class="kpi"><div class="kpi-top"><span class="kpi-label">Agents free</span></div>
      <div class="kpi-val" id="ag-free-<%= c.id %>">—</div>
      <div class="kpi-sub" id="ag-sub-<%= c.id %>">on the queue</div></div>
    <div class="kpi"><div class="kpi-top"><span class="kpi-label">Agents on a call</span></div>
      <div class="kpi-val" id="ag-busy-<%= c.id %>">—</div>
      <div class="kpi-sub">busy right now</div></div>
    <div class="kpi"><div class="kpi-top"><span class="kpi-label">Calls live</span></div>
      <div class="kpi-val" id="k-live-<%= c.id %>">—</div>
      <div class="kpi-sub" id="k-cap-<%= c.id %>">of the concurrency ceiling</div></div>
    <div class="kpi"><div class="kpi-top"><span class="kpi-label">Leads left</span></div>
      <div class="kpi-val" id="k-left-<%= c.id %>">—</div>
      <div class="kpi-sub">still dialable</div></div>
  </div>

  <div class="card">
    <table class="tbl"><thead><tr>
      <th>Ringing the lead</th><th>In the menu</th><th>Waiting for a key</th>
      <th>Ringing an agent</th><th>Talking to an agent</th><th>Placed this hour</th>
    </tr></thead><tbody><tr>
      <td class="mono" id="s-dial-<%= c.id %>">—</td>
      <td class="mono" id="s-greet-<%= c.id %>">—</td>
      <td class="mono" id="s-key-<%= c.id %>">—</td>
      <td class="mono" id="s-agent-<%= c.id %>">—</td>
      <td class="mono" id="s-bridged-<%= c.id %>">—</td>
      <td class="mono" id="s-hour-<%= c.id %>">—</td>
    </tr></tbody></table>
  </div>

  <div class="card" style="margin-top:10px">
    <table class="tbl"><thead><tr>
      <th>Dialled</th><th>Heard the prompt</th><th>Pressed something</th>
      <th>Transferred</th><th>Opted out</th><th>No keypress</th><th>Machines</th><th>Never connected</th>
    </tr></thead><tbody><tr>
      <td class="mono" id="t-dialed-<%= c.id %>">—</td>
      <td class="mono" id="t-heard-<%= c.id %>">—</td>
      <td class="mono" id="t-answered-<%= c.id %>">—</td>
      <td class="mono" id="t-conf-<%= c.id %>">—</td>
      <td class="mono" id="t-opt-<%= c.id %>">—</td>
      <td class="mono" id="t-nokey-<%= c.id %>">—</td>
      <td class="mono" id="t-mach-<%= c.id %>">—</td>
      <td class="mono" id="t-failed-<%= c.id %>">—</td>
    </tr></tbody></table>
    <div class="muted" style="font-size:11px;margin-top:8px" id="t-why-<%= c.id %>"></div>

    <!-- Counters say how many calls are up; these say WHICH numbers, and how
         the last few ended. That is what someone watching a running campaign
         is actually looking for. -->
    <div class="grid-2" style="margin-top:16px">
      <div>
        <div class="form-label">On the phone now</div>
        <div id="now-<%= c.id %>" class="muted" style="font-size:12px">—</div>
      </div>
      <div>
        <div class="form-label">Just finished
          <a style="font-weight:400;font-size:11px;margin-left:6px"
             href="/campaigns/<%= c.id %>/report">full report →</a></div>
        <div id="recent-<%= c.id %>" class="muted" style="font-size:12px">—</div>
      </div>
    </div>
  </div>
</div>
<% }) %>

<script>
var CAMPAIGN_IDS = <%- JSON.stringify(campaigns.map(function(c){ return c.id; })) %>;
var CEILINGS = <%- JSON.stringify(campaigns.reduce(function(m,c){ m[c.id]=c.pacing.maxConcurrent; return m; },{})) %>;

function put(id, v){ var el=document.getElementById(id); if(el) el.textContent = v; }
var STATE_WORDS={queued:'waiting its turn',dialing:'dialling',ringing:'ringing',answered:'answered',
  greeting:'playing prompt',playing:'playing prompt','awaiting-key':'waiting for a key',
  key:'waiting for a key','ringing-agent':'ringing agent',bridged:'with an agent',done:'done'};

function refreshCampaign(id){
  fetch('/api/campaigns/'+id+'/live',{credentials:'same-origin'})
    .then(function(r){ return r.json(); })
    .then(function(d){
      // Say so, rather than leaving every counter on a dash. A blank
      // dashboard is indistinguishable from a campaign that has quietly
      // stopped dialling, and that ambiguity costs real time to diagnose.
      if(!d.ok){
        put('note-'+id, d.error ? ('Dashboard error: '+d.error)
                                : 'Dashboard could not read this campaign.');
        return;
      }
      var pill=document.getElementById('st-'+id);
      if(pill){ pill.textContent=d.status;
        pill.className='pill '+(d.status==='running'?'p-ok':(d.status==='paused'?'p-warn':'p-gray')); }

      put('live-'+id, d.live ? d.live+' live' : '—');
      // Stale agent data is not zero agents; say which it is, because one is a
      // quiet campaign and the other is a broken feed.
      put('ag-free-'+id, d.agentsFresh ? d.agentsAvailable : '?');
      // Three different states, three different things to do about them:
      // live, running on a reading a few seconds old, or genuinely dark.
      var age = d.agentAgeMs == null ? null : Math.round(d.agentAgeMs/1000);
      put('ag-sub-'+id,
        !d.agentsFresh ? (d.agentNote || 'no data from the PBX')
          : (d.agentTransport === 'ws' && age !== null && age < 3
              ? 'of '+d.agentsTotal+' on the queue · live'
              : 'of '+d.agentsTotal+' on the queue · '+(age===null?'':age+'s ago')));
      put('ag-busy-'+id, d.agentsFresh ? d.agentsOnCall : '?');
      put('k-live-'+id, d.live);
      put('k-cap-'+id, 'ceiling '+(CEILINGS[id]||'—'));
      put('k-left-'+id, d.remaining);
      put('s-dial-'+id, d.dialing);
      put('s-greet-'+id, d.greeting);
      put('s-key-'+id, d.awaitingKey);
      put('s-agent-'+id, d.ringingAgent);
      put('s-bridged-'+id, d.bridged);
      put('s-hour-'+id, d.placedThisHour);
      var s=d.stats||{};
      put('t-dialed-'+id, s.dialed||0); put('t-heard-'+id, s.heardPrompt||0);
      put('t-answered-'+id, s.answered||0); put('t-conf-'+id, s.confirmed||0);
      put('t-opt-'+id, s.optedOut||0); put('t-nokey-'+id, s.noKeypress||0);
      put('t-mach-'+id, s.machines||0);
      put('t-failed-'+id, s.failed||0);
      put('t-why-'+id, (s.failed && s.lastFailure)
        ? 'Last failure: '+s.lastFailure : '');
      put('note-'+id, d.note||'');

      // Live numbers. Built as text nodes rather than innerHTML: a phone
      // number is data from a lead file, and it is not going to be the thing
      // that injects markup into this page.
      var now=document.getElementById('now-'+id);
      if(now){
        now.textContent='';
        var lc=d.liveCalls||[];
        if(!lc.length) now.textContent='Nothing in flight.';
        lc.slice(0,12).forEach(function(call){
          var row=document.createElement('div');
          row.style.cssText='display:flex;justify-content:space-between;padding:2px 0';
          var a=document.createElement('span'); a.className='mono'; a.textContent=call.phone;
          var b=document.createElement('span');
          b.textContent=STATE_WORDS[call.state]||call.state;
          b.textContent+=' · '+call.seconds+'s';
          row.appendChild(a); row.appendChild(b); now.appendChild(row);
        });
        if(lc.length>12){
          var more=document.createElement('div');
          more.textContent='+'+(lc.length-12)+' more';
          now.appendChild(more);
        }
      }

      var rec=document.getElementById('recent-'+id);
      if(rec){
        rec.textContent='';
        var rr=d.recent||[];
        if(!rr.length) rec.textContent='No calls recorded yet.';
        rr.slice(0,10).forEach(function(r){
          var row=document.createElement('div');
          row.style.cssText='display:flex;justify-content:space-between;padding:2px 0';
          var a=document.createElement('span'); a.className='mono'; a.textContent=r.phone;
          var b=document.createElement('span');
          b.textContent=r.label||r.outcome;
          if(r.outcome==='transferred') b.style.color='var(--ok,#2ecc71)';
          else if(r.outcome==='failed'||r.outcome==='no-answer') b.style.color='var(--bad,#e74c3c)';
          row.appendChild(a); row.appendChild(b); rec.appendChild(row);
        });
      }
    }).catch(function(){
      put('note-'+id,
        'Dashboard is not reaching the server — the campaign itself may still be dialling.');
    });
}
function loop(){ CAMPAIGN_IDS.forEach(refreshCampaign); setTimeout(loop, 2000); }
loop();
</script>
<%- include('foot') %>
