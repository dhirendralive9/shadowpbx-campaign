<%- include('head', { title: 'Overview', active: 'dashboard' }) %>
<%- include('flash') %>
<div class="kpi-row">
  <div class="kpi"><div class="kpi-top"><span class="kpi-label">Asterisk</span></div>
    <div class="kpi-val" id="k-ast">—</div><div class="kpi-sub" id="k-ver"></div></div>
  <div class="kpi"><div class="kpi-top"><span class="kpi-label">Active trunk</span></div>
    <div class="kpi-val" id="k-trunk">—</div>
    <div class="kpi-sub"><%= (settings.trunks.find(function(t){return t.id===settings.activeTrunkId;})||{}).name || 'none selected' %></div></div>
  <div class="kpi"><div class="kpi-top"><span class="kpi-label">ARI modules</span></div>
    <div class="kpi-val" id="k-ari">—</div><div class="kpi-sub">needed for call control</div></div>
  <div class="kpi"><div class="kpi-top"><span class="kpi-label">Active channels</span></div>
    <div class="kpi-val" id="k-chan">—</div><div class="kpi-sub">live calls</div></div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title">Trunk registration</div>
    <a class="sec-link" href="/trunks">Manage</a></div>
  <div class="card"><table class="tbl"><thead><tr><th>Trunk</th><th>Server URI</th><th>Status</th></tr></thead>
    <tbody id="regs"><tr><td colspan="3" class="muted">loading…</td></tr></tbody></table></div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title">Endpoints</div>
    <a class="sec-link" href="/servers">Manage</a></div>
  <div class="card"><table class="tbl"><thead><tr><th>Endpoint</th><th>State</th><th>Channels</th></tr></thead>
    <tbody id="eps"><tr><td colspan="3" class="muted">loading…</td></tr></tbody></table></div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title">Test call</div></div>
  <div class="card">
    <p class="muted" style="font-size:11px;margin-top:0">Dials one number, plays the greeting, waits for
      <strong><%= settings.ivr.confirmKey %></strong>, and bridges to the active server's agent extension.</p>
    <div class="row-flex">
      <input class="form-input w-auto" id="num" placeholder="49XXXXXXXXXX" style="max-width:240px">
      <button class="btn btn-primary" id="call">Place test call</button>
      <span id="callstate" class="muted" style="font-size:11px"></span>
    </div>
    <pre id="callout" class="out-pre" hidden></pre>
  </div>
</div>

<script>
function refresh(){
  fetch('/api/status').then(function(r){return r.json();}).then(function(d){
    if(!d.ok) return;
    var s=d.status;
    document.getElementById('k-ast').textContent = s.running?'Running':'Stopped';
    document.getElementById('k-ver').textContent = s.version||'';
    var reg=(s.registrations||[]).find(function(x){return /Registered/i.test(x.status);});
    document.getElementById('k-trunk').textContent =
      reg?'Registered':((s.registrations||[])[0]||{}).status||'None';
    document.getElementById('k-ari').textContent = s.ari.loaded;
    document.getElementById('k-chan').textContent = s.channels||0;

    document.getElementById('regs').innerHTML = (s.registrations||[]).length
      ? s.registrations.map(function(x){ return '<tr><td>'+x.name+'</td><td class="mono">'+x.uri+
        '</td><td><span class="pill '+(/Registered/i.test(x.status)?'p-ok':'p-err')+'">'+x.status+'</span></td></tr>'; }).join('')
      : '<tr><td colspan="3" class="muted">No trunks registering</td></tr>';
    document.getElementById('eps').innerHTML = (s.endpoints||[]).length
      ? s.endpoints.map(function(x){ return '<tr><td>'+x.name+'</td><td>'+x.state+'</td><td>'+x.channels+'</td></tr>'; }).join('')
      : '<tr><td colspan="3" class="muted">No endpoints configured</td></tr>';
  }).catch(function(){});
}
refresh(); setInterval(refresh,5000);
document.getElementById('call').onclick=function(){
  var n=document.getElementById('num').value.trim(); if(!n) return;
  var st=document.getElementById('callstate'),out=document.getElementById('callout'),b=this;
  st.textContent='calling… (up to 2 min)'; out.hidden=true; b.disabled=true;
  fetch('/api/test-call',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({number:n})}).then(function(r){return r.json();}).then(function(d){
      st.textContent=d.result||'done'; out.textContent=d.output||''; out.hidden=!d.output; b.disabled=false;
    }).catch(function(e){ st.textContent='failed: '+e.message; b.disabled=false; });
};
</script>
<%- include('foot') %>
