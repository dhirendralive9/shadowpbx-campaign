<%- include('head', { title: list.name, active: 'leads' }) %>
<%- include('flash') %>
<div class="section">
  <div class="sec-head">
    <div class="sec-title"><%= list.name %>
      <span class="pill p-info"><%= list.country || 'no country' %> +<%= list.dialCode %></span></div>
    <a class="sec-link" href="/leads">← All lists</a></div>

  <div class="kpi-row">
    <div class="kpi"><div class="kpi-top"><span class="kpi-label">Total</span></div>
      <div class="kpi-val"><%= stats.total %></div></div>
    <% ['pending','called','confirmed','failed'].forEach(function(k){ %>
      <div class="kpi"><div class="kpi-top"><span class="kpi-label"><%= k %></span></div>
        <div class="kpi-val"><%= stats.by[k] || 0 %></div></div>
    <% }) %>
  </div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title">Upload leads</div>
    <span class="muted" style="font-size:11px">CSV with a header row, or a plain list of numbers</span></div>
  <div class="card">
    <form method="post" action="/leads/<%= list.id %>/upload" enctype="multipart/form-data">
      <div class="grid-2">
        <div class="form-group"><label class="form-label">File</label>
          <input class="form-input" type="file" name="file"
                 accept=".csv,.txt,.tsv,text/csv,text/plain" required>
          <span class="muted" style="font-size:11px">.csv or .txt — the format is detected from the
            first line, so you do not have to say which.</span></div>
      </div>
      <button class="btn btn-primary" type="submit">Import</button>
    </form>

    <div class="grid-2" style="margin-top:18px">
      <div>
        <div class="form-label">CSV — with a header row</div>
        <pre class="out-pre" style="margin:4px 0">phone,name,company,email
+4915112345678,Anna Weber,Weber GmbH,anna@weber.de
004915798765432,Jonas Klein,,
15551234567,Pat Lee,Lee Co,pat@lee.com</pre>
        <span class="muted" style="font-size:11px">
          Only the phone column is required and it may be named
          <span class="mono">phone</span>, <span class="mono">number</span>,
          <span class="mono">mobile</span>, <span class="mono">cell</span>,
          <span class="mono">tel</span> or <span class="mono">msisdn</span>. If none of those match,
          the first column is used. <span class="mono">first name</span> and
          <span class="mono">last name</span> are joined when there is no
          <span class="mono">name</span>. A <span class="mono">prefix</span> or
          <span class="mono">country_code</span> column overrides this list's country code for that row.
        </span>
      </div>
      <div>
        <div class="form-label">Text — one number per line</div>
        <pre class="out-pre" style="margin:4px 0">+4915112345678
004915798765432
015112345678
9178 988 634</pre>
        <span class="muted" style="font-size:11px">
          No header, no other columns. Spaces, dashes, brackets and dots are ignored.
          Numbers that are already international (<span class="mono">+</span> or
          <span class="mono">00</span>) are kept as they are; the rest get this list's country code
          <span class="mono"><%= list.dialCode %></span>, with a leading national
          <span class="mono">0</span> dropped.
        </span>
      </div>
    </div>

    <div class="muted" style="font-size:11px;margin-top:12px">
      Either way: duplicates already in this list are skipped, anything under 7 digits is counted
      invalid, and the import reports lines read, imported, duplicates and invalid.
    </div>
  </div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title">List settings</div></div>
  <div class="card">
    <form method="post" action="/leads/<%= list.id %>/update">
      <div class="grid-2">
        <div class="form-group"><label class="form-label">Name</label>
          <input class="form-input" name="name" value="<%= list.name %>" required></div>
        <div class="form-group"><label class="form-label">Country</label>
          <select class="form-select" name="country">
            <% countries.forEach(function(c){ %>
              <option value="<%= c.code %>|<%= c.name %>"
                <%= (c.name === list.country && c.code === list.dialCode) ? 'selected' : '' %>>
                <%= c.name %> (+<%= c.code %>)</option>
            <% }) %>
          </select></div>
      </div>
      <button class="btn" type="submit">Save</button>
      <span class="muted" style="font-size:11px;margin-left:8px">Changing the country affects future imports, not rows already stored.</span>
    </form>
  </div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title">Leads</div>
    <span class="muted" style="font-size:11px" id="range">
      <%= pager.total ? pager.from + '–' + pager.to + ' of ' + pager.total : '0' %><%
        %><%= pager.filtered ? ' (filtered from ' + pager.grandTotal + ')' : '' %></span></div>

  <div class="card" style="margin-bottom:12px">
    <form method="get" class="grid-3" style="align-items:end;margin:0">
      <div class="form-group" style="margin:0"><label class="form-label">Status</label>
        <select class="form-select" name="status" onchange="this.form.submit()">
          <option value="">All statuses</option>
          <% Object.keys(counts).sort().forEach(function(k){ %>
            <option value="<%= k %>" <%= filter.status===k?'selected':'' %>><%= k %> (<%= counts[k] %>)</option>
          <% }); %>
        </select></div>
      <div class="form-group" style="margin:0"><label class="form-label">Search</label>
        <input class="form-input" name="q" value="<%= filter.q %>" placeholder="number, name or company"></div>
      <div class="form-group" style="margin:0"><label class="form-label">Rows per page</label>
        <select class="form-select" name="per" onchange="this.form.submit()">
          <% [50,100,200,500].forEach(function(n){ %>
            <option value="<%= n %>" <%= pager.per===n?'selected':'' %>><%= n %></option>
          <% }); %>
        </select></div>
      <div class="form-group" style="margin:0;grid-column:1/-1">
        <button class="btn btn-sm btn-primary">Apply</button>
        <a class="btn btn-sm" href="/leads/<%= list.id %>">Reset</a>
        <label class="muted" style="font-size:11px;margin-left:10px">
          <input type="checkbox" id="auto" checked> Keep this page up to date
        </label>
      </div>
    </form>
  </div>

  <div class="card">
    <% if (!rows.length) { %>
      <div class="empty" id="empty">
        <%= pager.grandTotal ? 'No leads match this filter.' : 'No leads yet — import a CSV above.' %>
      </div>
    <% } %>
    <table class="tbl" id="lead-table" <%= rows.length ? '' : 'style=display:none' %>><thead><tr>
      <th>Phone</th><th>Name</th><th>Company</th><th>Status</th><th>Attempts</th><th>Outcome</th>
    </tr></thead><tbody id="lead-rows">
    <% rows.forEach(function(r){ %>
      <tr><td class="mono"><%= r.phone %></td><td><%= r.name || '—' %></td>
        <td><%= r.company || '—' %></td>
        <td><span class="pill <%= r.status==='pending'?'p-gray':(r.status==='done'?'p-ok':(r.status==='dnc'?'p-warn':'p-info')) %>"><%= r.status %></span></td>
        <td><%= r.attempts %></td><td class="muted"><%= r.outcome || '—' %></td></tr>
    <% }) %>
    </tbody></table>

    <% if (pager.pages > 1) { %>
    <div class="row-flex" style="margin-top:14px;justify-content:space-between">
      <span class="muted" style="font-size:11px">Page <%= pager.page %> of <%= pager.pages %></span>
      <span class="row-flex">
        <% var qs = function(n){ return '?page=' + n + '&per=' + pager.per
             + '&status=' + encodeURIComponent(filter.status)
             + '&q=' + encodeURIComponent(filter.q); }; %>
        <a class="btn btn-sm" href="/leads/<%= list.id %><%= qs(1) %>"
           <%= pager.page===1?'style=visibility:hidden':'' %>>« First</a>
        <a class="btn btn-sm" href="/leads/<%= list.id %><%= qs(pager.page-1) %>"
           <%= pager.page===1?'style=visibility:hidden':'' %>>‹ Prev</a>
        <a class="btn btn-sm" href="/leads/<%= list.id %><%= qs(pager.page+1) %>"
           <%= pager.page===pager.pages?'style=visibility:hidden':'' %>>Next ›</a>
        <a class="btn btn-sm" href="/leads/<%= list.id %><%= qs(pager.pages) %>"
           <%= pager.page===pager.pages?'style=visibility:hidden':'' %>>Last »</a>
      </span>
    </div>
    <% } %>
  </div>
</div>

<script>
/*
 * Keep the visible page current.
 *
 * A lead list is read while a campaign is working through it, so statuses,
 * attempt counts and outcomes change under the reader. Without this the page
 * shows whatever was true when it was opened, which during a live run is
 * worse than showing nothing.
 *
 * Only the rows currently on screen are fetched, so the cost does not grow
 * with the size of the list.
 */
(function () {
  var LIST = <%- JSON.stringify(list.id) %>;
  var Q = { page: <%= pager.page %>, per: <%= pager.per %>,
            status: <%- JSON.stringify(filter.status) %>, q: <%- JSON.stringify(filter.q) %> };
  var PILL = { pending: 'p-gray', done: 'p-ok', dnc: 'p-warn' };

  function cell(text, cls) {
    var td = document.createElement('td');
    if (cls) td.className = cls;
    td.textContent = text == null || text === '' ? '—' : String(text);
    return td;
  }

  function draw(d) {
    var body = document.getElementById('lead-rows');
    if (!body) return;
    body.textContent = '';
    d.rows.forEach(function (r) {
      var tr = document.createElement('tr');
      tr.appendChild(cell(r.phone, 'mono'));
      tr.appendChild(cell(r.name));
      tr.appendChild(cell(r.company));
      var st = document.createElement('td');
      var pill = document.createElement('span');
      pill.className = 'pill ' + (PILL[r.status] || 'p-info');
      pill.textContent = r.status || 'pending';
      st.appendChild(pill); tr.appendChild(st);
      tr.appendChild(cell(r.attempts));
      tr.appendChild(cell(r.outcome, 'muted'));
      body.appendChild(tr);
    });
    var range = document.getElementById('range');
    if (range) {
      range.textContent = d.total ? d.from + '–' + d.to + ' of ' + d.total
        + (d.filtered ? ' (filtered from ' + d.grandTotal + ')' : '') : '0';
    }
  }

  function tick() {
    var box = document.getElementById('auto');
    if (!box || !box.checked) return;
    // A page in the background does not need refreshing, and a phone should
    // not be polling in someone's pocket.
    if (document.hidden) return;
    var u = '/api/leads/' + LIST + '/rows?page=' + Q.page + '&per=' + Q.per
          + '&status=' + encodeURIComponent(Q.status) + '&q=' + encodeURIComponent(Q.q);
    fetch(u, { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) { if (d.ok) draw(d); })
      .catch(function () {});
  }
  setInterval(tick, 5000);
})();
</script>

<%- include('foot') %>
