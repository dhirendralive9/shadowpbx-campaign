<%- include('layout_head') %>
<%- include('nav') %>
<main class="wrap">
  <% if (flash) { %><div class="alert ok"><%= flash %></div><% } %>
  <% if (flashErr) { %><div class="alert err"><%= flashErr %></div><% } %>
  <p class="muted sm">Saving rewrites <code>/etc/asterisk/pjsip.conf</code> and reloads PJSIP. No SSH needed.</p>

  <form method="post" action="/settings">
    <section class="card">
      <h2>German VoIP trunk</h2>
      <div class="grid">
        <label>SIP host<input class="inp" name="trunk_host" value="<%= settings.trunk.host %>" placeholder="sip.provider.de" required></label>
        <label>Username<input class="inp" name="trunk_user" value="<%= settings.trunk.user %>" required></label>
        <label>Password<input class="inp" name="trunk_pass" type="password" placeholder="<%= settings.trunk.pass ? '•••••••• (unchanged)' : 'required' %>"></label>
        <label>Port<input class="inp" name="trunk_port" type="number" value="<%= settings.trunk.port %>"></label>
        <label>Transport<select class="inp" name="trunk_transport">
          <% ['udp','tcp','tls'].forEach(function(t){ %>
            <option value="<%= t %>" <%= settings.trunk.transport===t?'selected':'' %>><%= t.toUpperCase() %></option>
          <% }) %>
        </select></label>
        <label>Caller ID<input class="inp" name="caller_id" value="<%= settings.trunk.callerId %>" placeholder="4915XXXXXXXX"></label>
      </div>
      <label class="chk"><input type="checkbox" name="trunk_register" <%= settings.trunk.register?'checked':'' %>> Register with the provider</label>
    </section>

    <section class="card">
      <h2>Main ShadowPBX <span class="muted sm">— where confirmed leads are sent</span></h2>
      <div class="grid">
        <label>PBX host / IP<input class="inp" name="pbx_host" value="<%= settings.pbx.host %>" placeholder="89.117.51.116" required></label>
        <label>SIP port<input class="inp" name="pbx_port" type="number" value="<%= settings.pbx.port %>"></label>
        <label>Agent extension<input class="inp" name="agent_exten" value="<%= settings.pbx.agentExten %>" placeholder="2000" required></label>
        <label>Agent API URL <span class="muted sm">(optional, later)</span><input class="inp" name="api_url" value="<%= settings.pbx.apiUrl %>" placeholder="https://pbx/api/campaign"></label>
        <label>API key<input class="inp" name="api_key" type="password" placeholder="<%= settings.pbx.apiKey ? '•••••••• (unchanged)' : 'not set' %>"></label>
      </div>
    </section>

    <section class="card">
      <h2>IVR behaviour</h2>
      <div class="grid">
        <label>Greeting
          <% if (sounds.length) { %>
            <select class="inp" name="greeting">
              <% sounds.forEach(function(s){ %>
                <option value="<%= s %>" <%= settings.ivr.greeting===s?'selected':'' %>><%= s %></option>
              <% }) %>
            </select>
          <% } else { %>
            <input class="inp" name="greeting" value="<%= settings.ivr.greeting %>">
          <% } %>
        </label>
        <label>Confirm key<input class="inp" name="confirm_key" value="<%= settings.ivr.confirmKey %>" maxlength="1"></label>
        <label>Opt-out key<input class="inp" name="optout_key" value="<%= settings.ivr.optOutKey %>" maxlength="1"></label>
        <label>Greetings before reject<input class="inp" name="max_greetings" type="number" min="1" max="5" value="<%= settings.ivr.maxGreetings %>"></label>
        <label>Wait per greeting (s)<input class="inp" name="wait_seconds" type="number" min="3" max="30" value="<%= settings.ivr.waitSeconds %>"></label>
      </div>
      <% if (!sounds.length) { %>
        <p class="alert warn sm">No sound files found in <code>/var/lib/asterisk/sounds/campaign/</code>. Add one with:
        <code>sox in.wav -r 8000 -c 1 -b 16 /var/lib/asterisk/sounds/campaign/greeting.wav</code></p>
      <% } %>
    </section>

    <div class="row"><button class="btn primary" type="submit">Save &amp; apply</button>
      <span class="muted sm">Writes pjsip.conf and reloads PJSIP immediately.</span></div>
  </form>
</main>
</body></html>
