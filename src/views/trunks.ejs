<%- include('head', { title: 'Trunks', active: 'trunks' }) %>
<%- include('flash') %>
<div class="section">
  <div class="sec-head"><div class="sec-title">SIP Trunks</div>
    <span class="muted" style="font-size:11px"><%= settings.trunks.length %> saved — the active one places calls</span></div>
  <div class="card">
    <% if (!settings.trunks.length) { %>
      <div class="empty">No trunks yet. Add one below.</div>
    <% } else { %>
    <table class="tbl"><thead><tr>
      <th>Name</th><th>Host</th><th>Username</th><th>Transport</th><th>Auth</th><th>Status</th><th></th>
    </tr></thead><tbody>
    <% settings.trunks.forEach(function(t){ var on = t.id === settings.activeTrunkId; %>
      <tr>
        <td><strong><%= t.name %></strong> <% if (on) { %><span class="pill p-ok">active</span><% } %></td>
        <td class="mono"><%= t.host %>:<%= t.port %></td>
        <td class="mono"><%= t.user %></td>
        <td><%= (t.transport||'udp').toUpperCase() %></td>
        <td><%= t.register ? 'Register' : 'IP auth' %></td>
        <td><span class="pill p-gray" data-reg="trunk-<%= t.id %>"
                 data-mode="<%= t.register ? 'register' : 'ip' %>">—</span></td>
        <td style="text-align:right;white-space:nowrap">
          <button class="btn btn-sm" onclick="editTrunk('<%= t.id %>')">Edit</button>
          <button class="btn btn-sm" onclick="openTest('<%= t.id %>','<%= t.name %>')">Test call</button>
          <button class="btn btn-sm" onclick="diagnose('<%= t.id %>','<%= t.name %>')">Diagnose</button>
          <% if (t.register) { %>
            <button class="btn btn-sm" onclick="reReg('<%= t.id %>', this)">Re-register</button>
          <% } %>
          <% if (!on) { %>
            <form class="inline-form" method="post" action="/trunks/<%= t.id %>/activate">
              <button class="btn btn-sm" type="submit">Use this</button></form>
          <% } %>
          <form class="inline-form" method="post" action="/trunks/<%= t.id %>/delete"
                onsubmit="return confirm('Delete trunk <%= t.name %>?')">
            <button class="btn btn-sm btn-danger" type="submit">Delete</button></form>
        </td>
      </tr>
    <% }) %>
    </tbody></table>
    <% } %>
  </div>
</div>

<div class="section">
  <div class="sec-head"><div class="sec-title" id="form-title">Add a trunk</div></div>
  <div class="card">
    <form method="post" action="/trunks/save" id="trunk-form">
      <input type="hidden" name="id" id="t-id">
      <div class="grid-3">
        <div class="form-group"><label class="form-label">Name</label>
          <input class="form-input" name="name" id="t-name" placeholder="German VoIP" required></div>
        <div class="form-group"><label class="form-label">SIP host</label>
          <input class="form-input" name="host" id="t-host" placeholder="sip.provider.de" required></div>
        <div class="form-group"><label class="form-label">Username</label>
          <input class="form-input" name="user" id="t-user" required></div>
        <div class="form-group"><label class="form-label">Password</label>
          <input class="form-input" name="pass" id="t-pass" type="password" placeholder="required"></div>
        <div class="form-group"><label class="form-label">Port</label>
          <input class="form-input" name="port" id="t-port" type="number" value="5060"></div>
        <div class="form-group"><label class="form-label">Transport</label>
          <select class="form-select" name="transport" id="t-transport">
            <option value="udp">UDP</option><option value="tcp">TCP</option><option value="tls">TLS</option>
          </select></div>
        <div class="form-group"><label class="form-label">Caller ID</label>
          <input class="form-input" name="callerId" id="t-cid" placeholder="4915XXXXXXXX"></div>
        <div class="form-group"><label class="form-label">Provider IPs <span class="muted">(optional)</span></label>
          <input class="form-input" name="matchIps" id="t-match" placeholder="37.187.146.93">
          <span class="muted" style="font-size:11px">Extra source IPs to accept inbound calls from, if they
            differ from the SIP host.</span></div>
      </div>
      <!-- The hidden field is load-bearing: an unticked checkbox submits nothing,
           so without it "off" is indistinguishable from "not sent" and
           registration can never actually be turned off. -->
      <input type="hidden" name="register" value="false">
      <label class="form-label" style="display:flex;align-items:center;gap:8px;margin:10px 0 6px">
        <input type="checkbox" name="register" id="t-register" value="true" checked> Register with the provider</label>
      <div class="muted" style="font-size:11px;margin-bottom:16px">
        Leave this off for an <strong>IP-authenticated</strong> account (your provider may call it
        “IP to IP”). Those accounts reject REGISTER with a bare 403 however correct the password is —
        the provider recognises this server by its public IP instead.</div>
      <button class="btn btn-primary" type="submit">Save trunk</button>
      <button class="btn" type="button" onclick="resetTrunk()">Cancel</button>
      <span class="muted" style="font-size:11px;margin-left:8px">Saving rewrites pjsip.conf and reloads PJSIP.</span>
    </form>
  </div>
</div>

<script>
var TRUNKS = <%- JSON.stringify(settings.trunks.map(function(t){
  return {id:t.id,name:t.name,host:t.host,user:t.user,port:t.port,transport:t.transport,
          register:t.register,callerId:t.callerId,matchIps:t.matchIps,
          hasPass:!!t.pass}; })) %>;
// "Register" with no password produces a config Asterisk quietly refuses: the
// registration object never loads, `pjsip show registrations` is empty, and the
// status pill stays blank with no error anywhere. Catch it at the point someone
// can still fix it.
document.addEventListener('DOMContentLoaded', function(){
  var f = document.getElementById('trunk-form');
  if (!f) return;
  f.addEventListener('submit', function(e){
    var cur = TRUNKS.find(function(x){ return x.id === t_id.value; });
    var stored = cur ? cur.hasPass : false;
    if (t_register.checked && !t_pass.value.trim() && !stored) {
      e.preventDefault();
      alert('"Register with the provider" needs a password.\n\n'
          + 'If this provider authenticates by IP ("IP to IP"), untick that box '
          + 'instead — otherwise Asterisk refuses the registration silently and '
          + 'the status column stays blank.');
      t_register.focus();
    }
  });
});

function editTrunk(id){
  var t = TRUNKS.find(function(x){return x.id===id;}); if(!t) return;
  t_id.value=t.id; t_name.value=t.name||''; t_host.value=t.host||''; t_user.value=t.user||'';
  t_port.value=t.port||5060; t_transport.value=t.transport||'udp'; t_cid.value=t.callerId||'';
  t_register.checked=!!t.register; t_match.value=t.matchIps||'';
  t_pass.placeholder='•••••••• (unchanged)'; t_pass.value='';
  document.getElementById('form-title').textContent='Edit trunk — '+(t.name||'');
  document.getElementById('trunk-form').scrollIntoView({behavior:'smooth'});
}
function resetTrunk(){
  document.getElementById('trunk-form').reset(); t_id.value='';
  t_pass.placeholder='required';
  document.getElementById('form-title').textContent='Add a trunk';
}
var t_id=document.getElementById('t-id'),t_name=document.getElementById('t-name'),
 t_host=document.getElementById('t-host'),t_user=document.getElementById('t-user'),
 t_pass=document.getElementById('t-pass'),t_port=document.getElementById('t-port'),
 t_transport=document.getElementById('t-transport'),t_cid=document.getElementById('t-cid'),
 t_register=document.getElementById('t-register'),t_match=document.getElementById('t-match');
// Live status. A registering trunk reports from `pjsip show registrations`;
// an IP-authenticated one never appears there at all, so its health is the
// qualify (OPTIONS) result against its AOR instead.
(function poll(){
  fetch('/api/status').then(r=>r.json()).then(function(d){
    if(!d.ok) return;
    document.querySelectorAll('[data-reg]').forEach(function(el){
      var name=el.getAttribute('data-reg');
      if(el.getAttribute('data-mode')==='ip'){
        var c=(d.status.contacts||[]).find(function(x){return x.aor===name;});
        if(!c){ el.textContent='no contact'; el.className='pill p-err'; return; }
        var up=/Avail|NonQual/i.test(c.status);
        el.textContent=(up?'reachable':'unreachable')+(c.rtt?' · '+c.rtt:'');
        el.className='pill '+(up?'p-ok':'p-err');
      } else {
        var r=(d.status.registrations||[]).find(function(x){return x.name===name;});
        if(!r){ el.textContent='—'; el.className='pill p-gray'; return; }
        el.textContent=r.status;
        el.className='pill '+(/Registered/i.test(r.status)?'p-ok':'p-err');
      }
    });
  }).catch(function(){});
  setTimeout(poll,5000);
})();
</script>

<div class="section" id="test-section" style="display:none">
  <div class="sec-head"><div class="sec-title" id="test-title">Test call</div>
    <button class="btn btn-sm" type="button" onclick="document.getElementById('test-section').style.display='none'">Close</button></div>
  <div class="card">
    <p class="muted" style="font-size:12px;margin:0 0 12px">
      Calls a number through this trunk and plays the audio you choose, then waits for a keypress.
      Answer it yourself and press <strong>1</strong> — that proves the trunk places calls, the audio is
      audible, and DTMF survives the carrier, which are three separate things that can fail on their own.
    </p>
    <input type="hidden" id="test-trunk">
    <div class="grid-3">
      <div class="form-group"><label class="form-label">Number to call</label>
        <input class="form-input" id="test-number" placeholder="491515302325">
        <span class="muted" style="font-size:11px">Full number with country code, digits only.</span></div>
      <div class="form-group"><label class="form-label">Audio to play</label>
        <select class="form-select" id="test-sound">
          <% if (!sounds.length) { %><option value="">No audio uploaded yet</option><% } %>
          <% sounds.forEach(function(a){ %>
            <option value="<%= a.soundId %>"><%= a.name %> (<%= a.seconds %>s)</option>
          <% }) %>
        </select>
        <span class="muted" style="font-size:11px">Upload more on the Audio tab.</span></div>
      <div class="form-group"><label class="form-label">Wait for a key (seconds)</label>
        <input class="form-input" id="test-wait" type="number" value="8" min="3" max="30"></div>
    </div>
    <button class="btn btn-primary" id="test-go" onclick="runTest()">Place test call</button>
    <span class="muted" style="font-size:11px;margin-left:8px">Your phone will ring within a few seconds.</span>
    <div id="test-result" style="margin-top:14px"></div>
    <pre class="out-pre" id="test-timeline" style="display:none"></pre>
  </div>
</div>

<script>
var testPoll=null;
function openTest(id,name){
  if(testPoll){clearTimeout(testPoll);testPoll=null;}
  var sec=document.getElementById('test-section');
  sec.style.display='';
  document.getElementById('test-title').textContent='Test call — '+name;
  document.getElementById('test-trunk').value=id;
  document.getElementById('test-result').innerHTML='';
  document.getElementById('test-timeline').style.display='none';
  sec.scrollIntoView({behavior:'smooth'});
}
function api(url,opts){
  var ctl=new AbortController(); var t=setTimeout(function(){ctl.abort();},15000);
  opts=opts||{}; opts.signal=ctl.signal; opts.credentials='same-origin';
  return fetch(url,opts).then(function(r){
    clearTimeout(t);
    if(!/json/.test(r.headers.get('content-type')||'')){
      throw new Error('server answered '+r.status+(r.redirected?' after redirecting to '+r.url+' (session expired - log in again)':' with a non-JSON page'));
    }
    return r.json();
  }).catch(function(e){
    clearTimeout(t);
    throw (e&&e.name==='AbortError')?new Error('no response from the server within 15s'):e;
  });
}
function testFail(msg){
  var btn=document.getElementById('test-go');
  btn.disabled=false; btn.textContent='Place test call';
  document.getElementById('test-result').innerHTML='<div class="alert alert-err">'+msg+'</div>';
}
function runTest(){
  if(testPoll){clearTimeout(testPoll);testPoll=null;}
  var id=document.getElementById('test-trunk').value;
  var btn=document.getElementById('test-go');
  var box=document.getElementById('test-result');
  var body={number:document.getElementById('test-number').value,
            sound:document.getElementById('test-sound').value,
            waitSeconds:document.getElementById('test-wait').value};
  btn.disabled=true; btn.textContent='Calling…';
  document.getElementById('test-timeline').style.display='none';
  box.innerHTML='<div class="alert alert-warn">Placing the call…</div>';
  api('/api/trunks/'+id+'/test-call',
      {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
   .then(function(d){
     if(!d.ok) return testFail(d.error||'The server refused the test call.');
     pollTest(d.jobId,0,Date.now());
   })
   .catch(function(e){ testFail('Could not start the test: '+e.message); });
}
function pollTest(jobId,fails,t0){
  var btn=document.getElementById('test-go');
  var box=document.getElementById('test-result');
  var tl=document.getElementById('test-timeline');
  api('/api/test-call/'+jobId).then(function(d){
    if(!d.ok) return testFail(d.error||'The test was lost on the server.');
    tl.style.display='';
    tl.textContent=(d.events||[]).map(function(e){
      return '+'+(e.at/1000).toFixed(1)+'s  '+e.text; }).join('\n');
    tl.scrollTop=tl.scrollHeight;
    if(d.finished){
      btn.disabled=false; btn.textContent='Place test call';
      box.innerHTML='<div class="alert '+(d.passed?'alert-ok':'alert-err')+'">'+d.result+'</div>';
      testPoll=null; return;
    }
    if(Date.now()-t0>180000) return testFail('Gave up waiting after 3 minutes (last state: '+d.state+').');
    box.innerHTML='<div class="alert alert-warn">'+d.state+'…</div>';
    testPoll=setTimeout(function(){pollTest(jobId,0,t0);},1000);
  }).catch(function(e){
    if(fails>=3) return testFail('Lost contact with the server while waiting for the result: '+e.message);
    testPoll=setTimeout(function(){pollTest(jobId,fails+1,t0);},1500);
  });
}
</script>

<div class="section" id="diag-section" style="display:none">
  <div class="sec-head"><div class="sec-title" id="diag-title">Diagnostics</div>
    <button class="btn btn-sm" type="button" onclick="document.getElementById('diag-section').style.display='none'">Close</button></div>
  <div class="card">
    <div id="diag-hint"></div>
    <div class="form-label" style="margin-top:10px">Registration</div>
    <pre class="out-pre" id="diag-reg"></pre>
    <div class="form-label" style="margin-top:10px">SIP exchange</div>
    <pre class="out-pre" id="diag-sip"></pre>
  </div>
</div>

<script>
function reReg(id, btn){
  var old=btn.textContent; btn.disabled=true; btn.textContent='…';
  fetch('/api/trunks/'+id+'/reregister',{method:'POST'}).then(function(r){return r.json();})
   .then(function(d){ btn.disabled=false; btn.textContent=old;
     alert(d.ok ? ('Status now: '+d.status) : ('Failed: '+(d.error||'')));
     location.reload(); })
   .catch(function(e){ btn.disabled=false; btn.textContent=old; alert(e.message); });
}
function diagnose(id, name){
  var sec=document.getElementById('diag-section');
  sec.style.display='';
  document.getElementById('diag-title').textContent='Diagnostics — '+name;
  document.getElementById('diag-hint').innerHTML='<span class="muted">Forcing a REGISTER and capturing the SIP exchange… (about 4s)</span>';
  document.getElementById('diag-reg').textContent='';
  document.getElementById('diag-sip').textContent='';
  sec.scrollIntoView({behavior:'smooth'});
  fetch('/api/trunks/'+id+'/diagnose').then(function(r){return r.json();}).then(function(d){
    if(!d.ok){ document.getElementById('diag-hint').innerHTML='<div class="alert alert-err">'+(d.error||'failed')+'</div>'; return; }
    document.getElementById('diag-hint').innerHTML = d.hint
      ? '<div class="alert alert-warn">'+d.hint+'</div>'
      : '<div class="alert alert-ok">No obvious failure code in the exchange — read the trace below.</div>';
    document.getElementById('diag-reg').textContent=d.registration||'(no output)';
    document.getElementById('diag-sip').textContent=d.sip||'(nothing captured — is /var/log/asterisk/full being written?)';
  }).catch(function(e){
    document.getElementById('diag-hint').innerHTML='<div class="alert alert-err">'+e.message+'</div>';
  });
}
</script>
<%- include('foot') %>
